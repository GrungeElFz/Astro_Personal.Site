---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
---

<BaseLayout title="Gee | Resume">
  <div class="mb-5 flex flex-row">
    <div class="indicator">
      <span class="indicator-item indicator-start badge badge-secondary"></span>
      <div class="grid h-10 w-10 place-items-center">
        <a
          href="https://drive.google.com/file/d/1UpSonhznecsmtGVZAGXN7UoeUBJZn5-K/view?usp=sharing"
          target="_blank"
          class="mr-3 text-primary tooltip tooltip-right"
          data-tip="Download my resume here 👀"
          aria-label="Resume"
          title="Resume"
          onclick="document.getElementById('resume-message').innerText = 'Thank you for checking my resume!   🥺👌 ❤️';"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="35"
            height="35"
            viewBox="0 0 24 24"
            style="fill: currentColor;transform: ;msFilter:;"
            ><path
              d="M8.267 14.68c-.184 0-.308.018-.372.036v1.178c.076.018.171.023.302.023.479 0 .774-.242.774-.651 0-.366-.254-.586-.704-.586zm3.487.012c-.2 0-.33.018-.407.036v2.61c.077.018.201.018.313.018.817.006 1.349-.444 1.349-1.396.006-.83-.479-1.268-1.255-1.268z"
            ></path><path
              d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zM9.498 16.19c-.309.29-.765.42-1.296.42a2.23 2.23 0 0 1-.308-.018v1.426H7v-3.936A7.558 7.558 0 0 1 8.219 14c.557 0 .953.106 1.22.319.254.202.426.533.426.923-.001.392-.131.723-.367.948zm3.807 1.355c-.42.349-1.059.515-1.84.515-.468 0-.799-.03-1.024-.06v-3.917A7.947 7.947 0 0 1 11.66 14c.757 0 1.249.136 1.633.426.415.308.675.799.675 1.504 0 .763-.279 1.29-.663 1.615zM17 14.77h-1.532v.911H16.9v.734h-1.432v1.604h-.906V14.03H17v.74zM14 9h-1V4l5 5h-4z"
            ></path></svg
          >
        </a>
      </div>
    </div>

    <!-- Opt-In: Disable Resume -->
    <!-- <div
      class="mr-3 cursor-not-allowed text-primary tooltip tooltip-right"
      data-tip="My resume is currently unavailable 👀"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="35"
        height="35"
        viewBox="0 0 24 24"
        style="fill: currentColor;transform: ;msFilter:;"
        ><path
          d="M8.267 14.68c-.184 0-.308.018-.372.036v1.178c.076.018.171.023.302.023.479 0 .774-.242.774-.651 0-.366-.254-.586-.704-.586zm3.487.012c-.2 0-.33.018-.407.036v2.61c.077.018.201.018.313.018.817.006 1.349-.444 1.349-1.396.006-.83-.479-1.268-1.255-1.268z"
        ></path><path
          d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zM9.498 16.19c-.309.29-.765.42-1.296.42a2.23 2.23 0 0 1-.308-.018v1.426H7v-3.936A7.558 7.558 0 0 1 8.219 14c.557 0 .953.106 1.22.319.254.202.426.533.426.923-.001.392-.131.723-.367.948zm3.807 1.355c-.42.349-1.059.515-1.84.515-.468 0-.799-.03-1.024-.06v-3.917A7.947 7.947 0 0 1 11.66 14c.757 0 1.249.136 1.633.426.415.308.675.799.675 1.504 0 .763-.279 1.29-.663 1.615zM17 14.77h-1.532v.911H16.9v.734h-1.432v1.604h-.906V14.03H17v.74zM14 9h-1V4l5 5h-4z"
        ></path></svg
      >
    </div> -->

    <div class="text-3xl font-bold">Profile</div>
  </div>

  <div class="mb-10">
    <p class="text-md py-3">
      An innovative front-end developer with a diverse skill set and a deep
      passion for technological advancement.
    </p>

    <p class="text-md py-3">
      Demonstrated success in previous careers as a professional cyclist,
      freelance photographer, color grader, and video editor. Known for
      exceptional organizational skills, self-driven approach to learning, and a
      commitment to delivering captivating user experiences.
    </p>

    <p class="text-md py-3">
      Proficient in utilizing a wide range of frameworks and libraries, such as
      SvelteKit, Astro, and TailwindCSS. Actively experimenting in cutting-edge
      tools such as Warp Terminal, Cursor IDE, and a multi-tool like Bun for
      enhanced development efficiency.
    </p>

    <p class="text-md py-3">
      Eager to contribute expertise to various high-impact digital projects.
    </p>
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Work Experience</div>
  </div>

  <div class="time-line-container mb-10">
    <TimeLineElement
      title="Senior Front-End Web Engineer"
      subtitle="Floatingpoint."
      date="Aug 2023 - Present"
    >
      <li>
        Achieved a 100 Lighthouse Performance score, 100 SEO, and 0 ms TBT ,
        architecting and deploying the floatingpoint.club platform using Astro,
        React, TailwindCSS, and Bun.
      </li>
      <li>
        Maintained a 0.4s LCP and 0 CLS, engineering edge-cached Vercel
        deployment pipelines and integrating Firebase backend services.
      </li>
      <li>
        Scaled platform traffic to 17,000+ unique visits and 100% capacity
        attendance in month one, developing dynamic event landing pages and
        optimizing Core Web Vitals.
      </li>
      <li>
        • Secured recurring commercial event partnerships with premier Chicago
        venues, engineering media and event integration pipelines alongside live
        audiovisual production systems.
      </li>
    </TimeLineElement>

    <TimeLineElement
      title="Front-End Web Engineer"
      subtitle="Pavlov Media"
      date="Jul 2023 - Sep 2024"
    >
      <li>
        Accelerated feature rollout velocity within 90 days of onboarding,
        shipping a production-ready portal widget for product delivery teams.
      </li>
      <li>
        • Supported 450,000+ active users across multi-state ISP infrastructure,
        maintaining and scaling high-availability commercial portals.
      </li>
      <li>
        • Slashed bundle size by 35% and dramatically reduced latency,
        spearheading an enterprise legacy migration from Angular to Svelte.
      </li>
      <li>
        • Drove 100% component adoption and eliminated front-end tech debt,
        building and rolling out a WCAG 2.1 AA-compliant design system across
        enterprise web applications.
      </li>
    </TimeLineElement>

    <TimeLineElement
      title="Front-End Web Developer"
      subtitle="Contract"
      date="Apr 2021 - Jul 2023"
    >
      <li>
        Secured a $3M seed funding round, rapidly deploying modular web
        applications with Astro and Svelte to deliver critical launch
        milestones.
      </li>
      <li>
        Sustained sub-second latency and 99.9% uptime during peak token
        generation event (TGE) traffic, architecting multi- region serverless
        edge infrastructure across Cloudflare Workers and Vercel.
      </li>
      <li>
        Cut global page load times by ~50% and doubled organic search conversion
        rates, overhauling server-side rendering pipelines and asset delivery.
      </li>
      <li>
        Reduced production deployment errors by 25% across mobile and desktop
        clients, instituting automated CI/CD testing pipelines and cross-browser
        regression suites.
      </li>
    </TimeLineElement>
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Education</div>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement
      title="University of Illinois Chicago"
      subtitle="Full-Stack Web Development Certification, Computer Software Engineering"
      date="Oct 2022"
      desc="A Full-time, immersive, web development program that focuses on implementing a practical skills set for dynamic collaborative environments in a tech field, centered on JavaScript, PERN stack, and git version control."
    />
    <TimeLineElement
      title="Alchemy University"
      subtitle="Ethereum Developer Certification, Web3 Development"
      date="Nov 2022"
      desc="The comprehensive Ethereum Developer Bootcamp that aims to provide the fundamentals of Web3 development such as cryptography, smart contracts, solidity, fully functional dApp development, and more.."
    />
    <TimeLineElement
      title="Parkland College"
      subtitle="Associate of Arts, Design and Applied Arts"
      date="Dec 2021"
    />
    <TimeLineElement
      title="Eastern Florida State College"
      subtitle="Associate's Degree, General Studies"
      date="Dec 2019"
    />
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Certificates</div>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement
      title="Cardano Blockchain Certified Associate (CBCA)"
      subtitle="Cardano Foundation"
      date="Issued Jun 2023"
    >
      <p class="my-2 text-justify mb-5">
        An in-depth course covering blockchain fundamentals, consensus
        algorithms, cryptography, encryptions, hash functions, digital
        signatures, and Cardano. Explore topics such as decentralized finance
        (DeFi), smart contracts, Web 3.0, and more.
      </p>
      <!-- <a href="https://academy.cardanofoundation.org" target="_blank">
          <img src="/Certification_CBCA.jpg" />
        </a> -->
    </TimeLineElement>

    <TimeLineElement
      title="BLOC529: Decentralized Finance"
      subtitle="University of Nicosia"
      date="Issued Sep 2022"
    >
      <p class="my-2 text-justify mb-5">
        A remote class that provides the field of decentralized finance (DeFi)
        and its main components, including decentralized exchanges (DEXs),
        automated market making (AMM), liquidity mining, yield farming,
        stable-coins, blockchain derivatives, DeFi protocol governance, and
        others.
      </p>
      <!-- <a
          href="https://opensea.io/assets/ethereum/0x05283b957cd69383429113e9ba41c95bafde3ec1/37"
          target="_blank"
        >
          <img
            src="https://i.seadn.io/gae/yHYtZVMRzVj903-M1GLet2BJiklFeOTXL54kcSFn1a38pGGZ5G-BlHIMlmGO20kn3_lgBA-TgRzE7YuD7Rsp6FR-JCJ7m6UFEPHk5g?auto=format&dpr=1&w=3840"
          />
        </a> -->
    </TimeLineElement>
  </div>

  <div id="resume-bubble" class="chat chat-end fixed bottom-5 right-5 z-50">
    <div class="chat-image avatar">
      <div class="w-10 rounded-full">
        <img src="profile.jpg" alt="Resume download bubble message" />
      </div>
    </div>
    <div class="chat-bubble chat-bubble-primary flex justify-between">
      <span id="resume-message">
        Click the ( 📄 ) Profile icon to download my resume!
      </span>
      <button
        onclick="document.getElementById('resume-bubble').remove()"
        class="font-thin text-gray-300 hover:text-gray-400 focus:outline-none self-center"
        aria-label="Close the bubble"
      >
        ✕
      </button>
    </div>
  </div>
</BaseLayout>
